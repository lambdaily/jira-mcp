# Jira site root, for example https://example.atlassian.net
JIRA_BASE_URL=

# Cloud: basic + account email/API token. Data Center: bearer + personal access token.
JIRA_AUTH_MODE=basic
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_API_VERSION=3

# Absolute path to a local clone of the repository Codex should work in.
TARGET_REPO_PATH=
BASE_BRANCH=dev
BRANCH_PREFIX=codex

# When true, jira_prepare_issue_branch also pushes the new branch to origin.
PUSH_BRANCH=false
